APP_ENV=development
# Origines autorisées (JSON). En production, remplacer le motif par l'ID exact de l'extension.
ALLOWED_ORIGINS=["http://localhost:3000"]
ALLOWED_ORIGIN_REGEX=^chrome-extension://[a-p]{32}$
# Moteur pour les textes inédits : mock | none (vrai moteur à brancher)
TRANSLATION_PROVIDER=mock
TRANSLATION_API_KEY=
PROVIDER_TIMEOUT_SECONDS=5
MAX_ITEMS_PER_REQUEST=100
MAX_TEXT_LENGTH=1000
